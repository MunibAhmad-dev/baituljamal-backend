PORT=5000
NODE_ENV=development

# PostgreSQL — e.g. postgresql://user:password@localhost:5432/baitul_jamal
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/baitul_jamal

JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_this

# One-time key to promote the first user to admin
ADMIN_SETUP_KEY=baitul-jamal-admin-2024

# URL where your frontend runs (for CORS)
CLIENT_URL=http://localhost:5173
